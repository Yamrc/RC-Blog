---
import BackToTop from "@components/base/BackToTop.astro";
import Navbar from "@components/navigation/Navbar.astro";
import Footer from "@components/site/Footer.astro";
import SideBar from "@components/widgets/SideBar.astro";
import TOC from "@components/widgets/TOC.astro";
import type { MarkdownHeading } from "astro";
import { siteConfig } from "@/config";
import Layout from "./Layout.astro";

interface Props {
	title?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	headings?: MarkdownHeading[];
	image?: string;
	canonical?: string;
	robots?: string;
	published?: Date;
	updated?: Date;
	category?: string | null;
}

const {
	title,
	description,
	lang,
	setOGTypeArticle,
	headings = [],
	image,
	canonical,
	robots,
	published,
	updated,
	category,
} = Astro.props;

const mainPanelTop = "5.5rem";
---

<Layout 
	title={title} 
	description={description} 
	lang={lang} 
	setOGTypeArticle={setOGTypeArticle}
	image={image}
	canonical={canonical}
	robots={robots}
	published={published}
	updated={updated}
	category={category}
>

<!-- Navbar -->
<slot slot="head" name="head"></slot>
<div id="top-row" class="z-50 pointer-events-none relative transition-all duration-700 max-page-width px-0 md:px-4 mx-auto" class:list={[""]}>
    <div id="navbar-wrapper" class="pointer-events-auto sticky top-0 transition-all">
        <Navbar></Navbar>
    </div>
</div>

<!-- Main content -->
<div class="absolute w-full z-30 pointer-events-none" style={`top: ${mainPanelTop}`}>
    <!-- The pointer-events-none here prevent blocking the click event of the TOC -->
    <div class="relative max-page-width mx-auto pointer-events-auto">
        <div id="main-grid" class="transition duration-700 w-full left-0 right-0 grid grid-cols-[17.5rem_auto] grid-rows-[auto_1fr_auto] lg:grid-rows-[auto]
    mx-auto gap-4 px-0 md:px-4"
        >
            <SideBar class="mb-4 row-start-2 row-end-3 col-span-2 lg:row-start-1 lg:row-end-2 lg:col-span-1 lg:max-w-[17.5rem] onload-animation" headings={headings} />

            <main id="swup-container" class="transition-swup-fade col-span-2 lg:col-span-1 overflow-hidden">
                <div id="content-wrapper" class="onload-animation">
                    <!-- the overflow-hidden here prevent long text break the layout-->
                    <!-- make id different from windows.swup global property -->
                    <slot></slot>
                    <div class="footer col-span-2 onload-animation hidden lg:block">
                        <Footer />
                    </div>
                </div>
            </main>

            <div class="footer col-span-2 onload-animation block lg:hidden">
                <Footer />
            </div>
        </div>

        <BackToTop />
    </div>
</div>

<!-- TOC container -->
<div class="absolute w-full z-0 hidden 2xl:block">
    <div class="relative max-page-width mx-auto">
        <!-- TOC component -->
        {siteConfig.toc.enable && <div id="toc-wrapper" class="hidden lg:block transition absolute top-0 -right-(--toc-width) w-(--toc-width) items-center"
        >
            <div id="toc-inner-wrapper" class="fixed top-14 w-(--toc-width) h-[calc(100vh-20rem)] overflow-y-scroll overflow-x-hidden hide-scrollbar">
                <div id="toc" class="w-full h-full transition-swup-fade ">
                    <div class="h-8 w-full"></div>
                    <TOC headings={headings} />
                    <div class="h-8 w-full"></div>
                </div>
            </div>
        </div>}

        <!-- #toc needs to exist for Swup to work normally -->
        {!siteConfig.toc.enable && <div id="toc"></div>}
    </div>
</div>
</Layout>
